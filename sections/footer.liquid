<footer class="footer full-width">
  <div class="footer__inner">
    <div class="footer__brand">
      <a class="logo" href="{{ routes.root_url }}">{%- render 'logo' -%}</a>
      {%- if section.settings.about != blank -%}
        <div class="footer__about">{{ section.settings.about }}</div>
      {%- endif -%}

      {%- liquid
        assign socials = 'instagram,youtube,tiktok,discord' | split: ','
      -%}
      <ul class="footer__social">
        {%- for name in socials -%}
          {%- assign key = 'social_' | append: name -%}
          {%- if settings[key] != blank -%}
            <li><a class="pill pill--outline" href="{{ settings[key] }}" target="_blank" rel="noopener">{{ name | capitalize }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'newsletter' -%}
          <div class="footer__col footer__col--wide" {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            {%- if block.settings.text != blank -%}
              <p class="footer__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- form 'customer', class: 'footer__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="pill pill--olive">{{ 'newsletter.success' | t }}</p>
              {%- else -%}
                <label class="visually-hidden" for="FooterEmail-{{ block.id }}">{{ 'newsletter.email' | t }}</label>
                <input
                  class="input"
                  id="FooterEmail-{{ block.id }}"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  placeholder="{{ 'newsletter.email' | t }}"
                  required
                >
                <button class="btn" type="submit">{{ 'newsletter.submit' | t }}</button>
              {%- endif -%}
            {%- endform -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ powered_by_link }}</p>

    {%- if section.settings.show_payment_icons -%}
      <ul class="footer__payment" aria-label="{{ 'footer.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .footer {
    margin-top: clamp(2rem, 1rem + 4vw, 4rem);
    padding: 0 var(--page-margin) var(--page-margin);
  }

  .footer__inner,
  .footer__bottom {
    max-width: calc(var(--page-width) - var(--page-margin) * 2);
    margin-inline: auto;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.5fr;
    gap: 2.5rem;
    padding: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-secondary);
  }

  .footer__about {
    margin-top: 1rem;
    max-width: 22rem;
    font-size: 0.95rem;
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .footer__social a {
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--color-foreground);
  }

  .footer__heading {
    font-family: var(--font-primary--family);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    text-decoration: none;
  }

  .footer__col a:hover {
    text-decoration: underline;
  }

  .footer__text {
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .footer__form {
    display: flex;
    gap: 0.5rem;
  }

  .footer__form .input {
    border-color: transparent;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0.5rem 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .footer__bottom a {
    text-decoration: none;
  }

  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }

  .footer__payment svg {
    height: 1.5rem;
    width: auto;
  }

  @media (max-width: 989px) {
    .footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__brand,
    .footer__col--wide {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer__form {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "richtext",
      "id": "about",
      "label": "t:labels.text",
      "default": "<p>Axion is a small keyboard workshop. We test every switch we sell and help you put together a board that feels like yours.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:general.menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "t:labels.menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:general.newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Group buys & restocks" },
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "One calm email a month. No spam, just new switches." }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
