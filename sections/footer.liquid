{%- liquid
  assign socials = 'instagram:IG,youtube:YT,tiktok:TT,discord:DC' | split: ','
  assign wordmark = section.settings.wordmark | default: shop.name | downcase
  assign wordmark_letters = wordmark | split: ''
-%}

<footer class="footer full-width">
  <div class="footer__panel">
    <div class="footer__top">
      <div class="footer__pitch">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="footer__headline">{{ section.settings.headline }}</h2>
      </div>

      {%- form 'customer', class: 'footer__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="footer__thanks">{{ 'icon-check.svg' | inline_asset_content }} {{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <label class="visually-hidden" for="FooterEmail">{{ 'newsletter.email' | t }}</label>
          <input
            class="footer__input"
            id="FooterEmail"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="{{ 'newsletter.email' | t }}"
            required
          >
          <button class="footer__enter" type="submit">
            <span class="footer__enter-legend mono">{{ 'newsletter.submit' | t }}</span>
            <span aria-hidden="true">↵</span>
          </button>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <a class="logo" href="{{ routes.root_url }}">{%- render 'logo' -%}</a>
        {%- if section.settings.about != blank -%}
          <div class="footer__about">{{ section.settings.about }}</div>
        {%- endif -%}

        <ul class="footer__social" role="list">
          {%- for social in socials -%}
            {%- liquid
              assign pair = social | split: ':'
              assign key = 'social_' | append: pair[0]
            -%}
            {%- if settings[key] != blank -%}
              <li>
                <a class="footer__key mono" href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ pair[0] | capitalize }}">
                  {{- pair[1] -}}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
          <h2 class="footer__heading mono">{{ block.settings.heading }}</h2>
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'info' -%}
              <div class="footer__info">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <p class="footer__wordmark" aria-hidden="true">
      {%- for letter in wordmark_letters -%}
        <span style="--i: {{ forloop.index0 }};">{{ letter }}</span>
      {%- endfor -%}
    </p>
  </div>

  <div class="footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }} · {{ powered_by_link }}</p>

    {%- if section.settings.signoff != blank -%}
      <p class="footer__signoff mono">{{ section.settings.signoff }}</p>
    {%- endif -%}

    <div class="footer__end">
      {%- if section.settings.show_payment_icons -%}
        <ul class="footer__payment" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <a class="footer__top-key" href="#" data-back-to-top>
        <span class="mono">Home</span>
        {{ 'icon-up.svg' | inline_asset_content }}
        <span class="visually-hidden">{{ 'footer.back_to_top' | t }}</span>
      </a>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    margin-top: clamp(2rem, 1rem + 4vw, 4rem);
    padding: 0 var(--page-margin) 1.25rem;
  }

  .footer__panel,
  .footer__bottom {
    max-width: calc(var(--page-width) - var(--page-margin) * 2);
    margin-inline: auto;
  }

  .footer__panel {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem) clamp(1.5rem, 1rem + 3vw, 3.5rem) 0;
    border-radius: var(--radius-lg);
    background: var(--color-secondary);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: end;
    gap: 1.5rem 3rem;
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .footer__headline {
    max-width: 18ch;
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.8rem);
  }

  .footer__form {
    display: flex;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: calc(var(--radius-sm) + 0.4rem);
    background: rgb(255 255 255 / 0.35);
  }

  .footer__input {
    flex: 1;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0 1rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .footer__input:focus {
    outline: none;
    box-shadow: 0 0 0 3px var(--color-accent);
  }

  /* Submit button shaped like an ISO Enter key legend. */
  .footer__enter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    min-width: 6.5rem;
    padding: 0.4rem 0.8rem 0.55rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    box-shadow: var(--shadow-key);
    font-size: 1.15rem;
    line-height: 1;
    transition: transform 0.08s ease, box-shadow 0.08s ease;
  }

  .footer__enter:active {
    transform: translateY(3px);
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.16);
  }

  .footer__enter-legend {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .footer__enter > span:last-child {
    align-self: flex-end;
  }

  .footer__thanks {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1rem;
    font-weight: 600;
  }

  .footer__thanks svg {
    width: 1.2rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 2rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.22);
  }

  .footer__about {
    margin-top: 1rem;
    max-width: 22rem;
    font-size: 0.95rem;
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .footer__key {
    display: grid;
    place-items: start;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.35rem 0.45rem;
    border-radius: 0.6rem;
    background: var(--color-background);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: inset 0 -3px 0 var(--color-well-strong), 0 1px 2px rgb(0 0 0 / 0.1);
    transition: transform 0.08s ease, background-color 0.2s ease;
  }

  .footer__key:hover {
    background: var(--color-accent);
  }

  .footer__key:active {
    transform: translateY(2px);
  }

  .footer__heading {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    transition: background-size 0.25s ease;
  }

  .footer__col a:hover {
    background-size: 100% 1px;
  }

  .footer__info {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* Oversized wordmark; each letter sinks like a key when hovered. */
  .footer__wordmark {
    display: flex;
    justify-content: center;
    margin: clamp(1rem, 0.5rem + 2vw, 2rem) 0 -0.2em;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(5.5rem, 21vw, 19rem);
    letter-spacing: -0.05em;
    line-height: 0.8;
    color: var(--color-secondary-dark);
    user-select: none;
  }

  .footer__wordmark span {
    transition: transform 0.12s ease, color 0.2s ease;
  }

  .footer__wordmark span:hover {
    transform: translateY(0.06em);
    color: var(--color-accent-dark);
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0.5rem 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .footer__bottom a {
    text-decoration: none;
  }

  .footer__signoff {
    font-size: 0.75rem;
    text-align: center;
  }

  .footer__end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
  }

  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }

  .footer__payment svg {
    height: 1.5rem;
    width: auto;
  }

  .footer__top-key {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0.4rem 0.5rem 0.55rem;
    border-radius: 0.7rem;
    background: var(--color-surface);
    color: var(--color-foreground);
    font-size: 0.65rem;
    font-weight: 600;
    box-shadow: var(--shadow-key), var(--shadow-sm);
    transition: transform 0.08s ease;
  }

  .footer__top-key svg {
    align-self: flex-end;
    width: 0.95rem;
  }

  .footer__top-key:hover {
    transform: translateY(-2px);
  }

  .footer__top-key:active {
    transform: translateY(2px);
  }

  @media (max-width: 989px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__brand,
    .footer__col--info {
      grid-column: 1 / -1;
    }

    .footer__bottom {
      grid-template-columns: 1fr auto;
    }

    .footer__signoff {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .footer__form {
      flex-direction: column;
    }

    .footer__enter {
      flex-direction: row;
      align-items: center;
      min-height: 3.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Group buys & restocks" },
    { "type": "text", "id": "headline", "label": "t:labels.heading", "default": "New switches land here first. One calm email a month." },
    {
      "type": "richtext",
      "id": "about",
      "label": "t:labels.text",
      "default": "<p>Axion is a small keyboard workshop. We test every switch we sell and help you put together a board that feels like yours.</p>"
    },
    { "type": "text", "id": "wordmark", "label": "t:labels.wordmark", "info": "t:info.wordmark" },
    { "type": "text", "id": "signoff", "label": "t:labels.signoff", "default": "typed on a 65% · walnut tactiles" },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:general.menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "t:labels.menu", "default": "footer" }
      ]
    },
    {
      "type": "info",
      "name": "t:general.text",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Workshop" },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Mon–Fri, 10:00–18:00<br>Try any switch in person — the tester board is always out.</p>"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
