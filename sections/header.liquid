{%- liquid
  assign menu = section.settings.menu
  assign cta_link = section.settings.cta_link | default: '/pages/build'
-%}

<div class="header-wrap full-width{% if section.settings.sticky %} header-wrap--sticky{% endif %}">
  <header class="header">
    <details class="header__drawer" scroll-lock>
      <summary class="header__icon header__icon--menu" aria-label="{{ 'header.menu' | t }}">
        <span class="icon-open">{{ 'icon-menu.svg' | inline_asset_content }}</span>
        <span class="icon-close">{{ 'icon-close.svg' | inline_asset_content }}</span>
      </summary>
      <nav class="drawer" aria-label="{{ 'header.menu' | t }}">
        <ul class="drawer__list">
          {%- for link in menu.links -%}
            <li>
              {%- if link.links != blank -%}
                <details class="drawer__sub">
                  <summary>
                    {{ link.title }}
                    {{ 'icon-chevron.svg' | inline_asset_content }}
                  </summary>
                  <ul>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--block" href="{{ cta_link }}">
            {{ 'icon-keyboard.svg' | inline_asset_content }}
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </nav>
    </details>

    <a class="logo" href="{{ routes.root_url }}">
      {%- render 'logo' -%}
    </a>

    <nav class="header__nav" aria-label="{{ 'header.menu' | t }}">
      <ul class="header__menu">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links != blank -%}
              <details class="header__dropdown">
                <summary class="header__link{% if link.child_active %} is-active{% endif %}">
                  {{ link.title }}
                  {{ 'icon-chevron.svg' | inline_asset_content }}
                </summary>
                <ul class="header__submenu">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="header__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                {{- link.title -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      {%- if section.settings.cta_label != blank -%}
        <a class="btn header__cta" href="{{ cta_link }}">
          {{ 'icon-keyboard.svg' | inline_asset_content }}
          <span>{{ section.settings.cta_label }}</span>
        </a>
      {%- endif -%}

      <a class="header__icon header__icon--tip" href="{{ routes.search_url }}" aria-label="{{ 'search.title' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
        <span class="header__tip" aria-hidden="true">{{ 'search.title' | t }} <kbd>/</kbd></span>
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <span class="header__icon header__icon--account">
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        </span>
      {%- endif -%}

      <a class="header__icon header__icon--cart" href="{{ routes.cart_url }}" aria-label="{{ 'cart.title' | t }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>
          {{- cart.item_count -}}
        </span>
      </a>
    </div>
  </header>
</div>

{% stylesheet %}
  .header-wrap {
    z-index: 20;
    padding: 0.75rem var(--page-margin);
    background: var(--color-background);
  }

  .header-wrap--sticky {
    position: sticky;
    top: 0;
  }

  .shopify-section-group-header-group:has(.header-wrap--sticky) {
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    max-width: calc(var(--page-width) - var(--page-margin) * 2);
    margin-inline: auto;
    padding: 0.5rem 0.6rem 0.5rem 1.1rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .header__nav {
    justify-self: center;
  }

  .header__menu {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease;
  }

  .header__link::-webkit-details-marker {
    display: none;
  }

  .header__link svg {
    width: 1rem;
    transition: transform 0.2s ease;
  }

  .header__link:hover,
  .header__link.is-active {
    background: var(--color-tertiary-soft);
  }

  .header__dropdown {
    position: relative;
  }

  .header__dropdown[open] .header__link svg {
    transform: rotate(180deg);
  }

  .header__submenu {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    min-width: 13rem;
    padding: 0.5rem;
    list-style: none;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow);
  }

  .header__submenu a {
    display: block;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .header__submenu a:hover {
    background: var(--color-tertiary-soft);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header__cta {
    min-height: 2.6rem;
    padding: 0.45rem 1.1rem 0.55rem;
    margin-right: 0.35rem;
    font-size: 0.9rem;
  }

  .header__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    color: var(--color-foreground);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease;
  }

  .header__icon::-webkit-details-marker {
    display: none;
  }

  .header__icon:hover {
    background: var(--color-tertiary-soft);
  }

  .header__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .header__tip {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .header__icon--tip:hover .header__tip,
  .header__icon--tip:focus-visible .header__tip {
    opacity: 1;
    transform: translate(-50%, 0);
    transition-delay: 0.3s;
  }

  .cart-count {
    position: absolute;
    top: 0.1rem;
    right: 0.05rem;
    display: grid;
    place-items: center;
    min-width: 1.2rem;
    height: 1.2rem;
    padding-inline: 0.3rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 0 0 2px var(--color-surface);
  }

  .cart-count.is-empty {
    display: none;
  }

  .header__drawer {
    display: none;
  }

  .header__drawer .icon-close,
  .header__drawer[open] .icon-open {
    display: none;
  }

  .header__drawer[open] .icon-close {
    display: block;
  }

  .drawer {
    position: fixed;
    inset: 5.25rem var(--page-margin) auto;
    max-height: calc(100svh - 6.5rem);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow);
    animation: drawer-in 0.25s ease;
  }

  @keyframes drawer-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .drawer__list,
  .drawer__list ul {
    list-style: none;
    padding: 0;
  }

  .drawer__list a,
  .drawer__list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .drawer__list summary svg {
    width: 1.1rem;
  }

  .drawer__list a:hover,
  .drawer__list summary:hover {
    background: var(--color-tertiary-soft);
  }

  .drawer__sub ul {
    padding-left: 0.75rem;
  }

  .drawer__sub ul a {
    font-size: 1rem;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .header {
      grid-template-columns: auto 1fr auto;
      padding-left: 0.4rem;
    }

    .header__drawer {
      display: block;
    }

    .header__nav,
    .header__cta {
      display: none;
    }

    .logo {
      justify-self: start;
    }
  }

  @media (max-width: 420px) {
    .header__icon--account {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:labels.sticky_header",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.builder_button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label",
      "default": "Build yours"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.button_link"
    }
  ]
}
{% endschema %}
