{%- liquid
  assign illos = 'illo-keyboard.svg,illo-switch-linear.svg,illo-keycaps.svg' | split: ','
  assign tones = 'var(--color-tertiary-soft),var(--color-accent-soft),var(--color-secondary-soft)' | split: ','
-%}

<div class="categories section">
  {%- if section.settings.heading != blank -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--olive">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="categories__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign i = forloop.index0 | modulo: 3
        assign collection = block.settings.collection
        assign title = block.settings.title | default: collection.title
        assign url = collection.url | default: block.settings.link | default: routes.all_products_collection_url
      -%}
      <a class="category" href="{{ url }}" style="--tile: {{ tones[i] }};" {{ block.shopify_attributes }}>
        <div class="category__media">
          <span class="category__no mono" aria-hidden="true">№ {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- if block.settings.note != blank -%}
            <span class="category__note mono">{{ block.settings.note }}</span>
          {%- endif -%}
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw' }}
          {%- elsif collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw' }}
          {%- else -%}
            <img class="category__illo" src="{{ illos[i] | asset_url }}" alt="" width="400" height="300" loading="lazy">
          {%- endif -%}
        </div>
        <div class="category__info">
          <div>
            <h3>{{ title }}</h3>
            <p>
              {{- block.settings.caption -}}
              {%- if collection.products_count > 0 -%}
                <span class="category__count mono">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
              {%- endif -%}
            </p>
          </div>
          <span class="category__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .category__no {
    position: absolute;
    z-index: 1;
    top: 1rem;
    left: 1.2rem;
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .category__note {
    position: absolute;
    z-index: 1;
    top: 0.9rem;
    right: 0.9rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: 0.7rem;
    box-shadow: var(--shadow-sm);
  }

  /* Dashed leader line from the note down to the product, like a spec drawing. */
  .category__note::before,
  .category__note::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .category__note::before {
    top: 100%;
    left: 1.25rem;
    width: 1px;
    height: 2.4rem;
    background: repeating-linear-gradient(to bottom, var(--color-foreground) 0 3px, transparent 3px 6px);
    opacity: 0.35;
  }

  .category__note::after {
    top: calc(100% + 2.4rem);
    left: calc(1.25rem - 3px);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-dark);
  }

  .category__count {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    opacity: 0.8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.category_tiles",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Parts bin" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Shop by part" },
    { "type": "text", "id": "text", "label": "t:labels.text", "default": "Everything you need for a board that sounds, feels and looks right." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:general.tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:labels.collection" },
        { "type": "text", "id": "title", "label": "t:labels.heading" },
        { "type": "text", "id": "caption", "label": "t:labels.caption" },
        { "type": "text", "id": "note", "label": "t:labels.spec_note" },
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        { "type": "url", "id": "link", "label": "t:labels.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.category_tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Keyboards", "caption": "Cases, kits & ready-to-type boards", "note": "hot-swap · gasket mount" } },
        { "type": "tile", "settings": { "title": "Switches", "caption": "Linear, tactile and clicky", "note": "5-pin · factory lubed" } },
        { "type": "tile", "settings": { "title": "Keycaps", "caption": "PBT sets in calm colours", "note": "PBT · 1.5 mm · dye-sub" } }
      ]
    }
  ]
}
{% endschema %}
