<div class="password section">
  <div class="password__card">
    <a class="logo" href="{{ routes.root_url }}">{%- render 'logo' -%}</a>
    <img src="{{ 'illo-keyboard.svg' | asset_url }}" alt="" width="400" height="200">
    <h1 class="h2">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}{{ form.errors | default_errors }}{%- endif -%}
      <label class="visually-hidden" for="PasswordInput">{{ 'password.password' | t }}</label>
      <input class="input" type="password" name="password" id="PasswordInput" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
      <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .password {
    min-height: 100svh;
    align-content: center;
  }

  .password__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 32rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border), var(--shadow);
    text-align: center;
  }

  .password__card > img {
    width: 80%;
  }

  .password__card p {
    color: var(--color-muted);
  }

  .password__form {
    display: flex;
    gap: 0.5rem;
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
