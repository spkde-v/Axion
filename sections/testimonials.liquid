{% comment %}
  Customer notes pinned to the wall, each with a drawing of the board they built.
{% endcomment %}

<div class="notes section">
  <div class="section-head">
    <div class="section-head__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--olive">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="notes__wall">
    {%- for block in section.blocks -%}
      <figure class="note" style="--r: {% cycle '-1.4deg', '1deg', '-0.6deg', '1.6deg' %};" {{ block.shopify_attributes }}>
        <span class="note__tape" aria-hidden="true"></span>

        <div
          class="note__board"
          data-mini-board
          data-layout="{{ block.settings.layout }}"
          data-case="{{ block.settings.case_color }}"
          data-alpha="{{ block.settings.cap_color }}"
          data-mod="{{ block.settings.mod_color }}"
          data-accent="{{ block.settings.accent_color }}"
          aria-hidden="true"
        ></div>

        <blockquote class="note__quote">{{ block.settings.quote }}</blockquote>

        <figcaption class="note__by">
          <span>
            <strong>{{ block.settings.author }}</strong>
            {%- if block.settings.build != blank -%}
              <small class="mono">{{ block.settings.build }}</small>
            {%- endif -%}
          </span>
          {%- if block.settings.wpm != blank -%}
            <span class="note__wpm mono">{{ block.settings.wpm }}<small>wpm</small></span>
          {%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
</div>

<script src="{{ 'axion-render.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .notes__wall {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    padding-top: 0.75rem;
  }

  .note {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin: 0;
    padding: 1.6rem 1.6rem 1.4rem;
    border-radius: 6px 6px var(--radius) var(--radius);
    /* Ruled index card */
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0 1.6rem,
        var(--color-well) 1.6rem calc(1.6rem + 1px)
      )
      0 4.5rem / 100% calc(100% - 4.5rem) no-repeat,
      #fffef8;
    box-shadow: var(--shadow-card);
    transform: rotate(var(--r));
    transition: transform 0.3s ease;
  }

  .note:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .note__tape {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 5.5rem;
    height: 1.5rem;
    background: var(--color-accent);
    opacity: 0.55;
    transform: translateX(-50%) rotate(calc(var(--r) * -2.5));
    clip-path: polygon(0 12%, 3% 0, 97% 6%, 100% 30%, 98% 62%, 100% 92%, 96% 100%, 4% 94%, 1% 70%, 3% 40%);
  }

  .note:nth-child(3n + 2) .note__tape {
    background: var(--color-secondary);
  }

  .note__board {
    align-self: center;
    width: 72%;
    min-height: 3.5rem;
  }

  .note__board svg {
    width: 100%;
    height: auto;
  }

  .note__quote {
    flex: 1;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6rem;
  }

  .note__quote::before {
    content: '“';
    margin-right: 0.1em;
    color: var(--color-accent-dark);
    font-family: var(--font-heading--family);
    font-size: 1.6em;
    line-height: 0;
    vertical-align: -0.3em;
  }

  .note__by {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .note__by small {
    display: block;
    color: var(--color-muted);
    font-size: 0.72rem;
  }

  .note__wpm {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: var(--color-tertiary-soft);
    color: var(--color-secondary-dark);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    transform: rotate(-12deg);
  }

  .note__wpm small {
    display: block;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.testimonials",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Notes from the desk" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "What people built, in their words" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:general.quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "t:labels.text", "default": "The builder made it so easy to see what I was getting." },
        { "type": "text", "id": "author", "label": "t:labels.author", "default": "Customer" },
        { "type": "text", "id": "build", "label": "t:labels.caption" },
        { "type": "text", "id": "wpm", "label": "t:labels.wpm" },
        { "type": "header", "content": "t:labels.their_build" },
        {
          "type": "select",
          "id": "layout",
          "label": "t:labels.layout",
          "options": [
            { "value": "60", "label": "60%" },
            { "value": "65", "label": "65%" },
            { "value": "75", "label": "75%" },
            { "value": "tkl", "label": "TKL" }
          ],
          "default": "65"
        },
        { "type": "color", "id": "case_color", "label": "t:labels.case_color", "default": "#97A87A" },
        { "type": "color", "id": "cap_color", "label": "t:labels.cap_color", "default": "#FCF9EA" },
        { "type": "color", "id": "mod_color", "label": "t:labels.mod_color", "default": "#A8BBA3" },
        { "type": "color", "id": "accent_color", "label": "t:labels.accent", "default": "#DB9558" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.testimonials",
      "blocks": [
        { "type": "quote", "settings": { "quote": "I'd never built a keyboard before. The preview showed exactly the colours that turned up at my door.", "author": "Mira K.", "build": "65% · walnut tactile · meadow", "wpm": "94", "layout": "65", "case_color": "#97A87A", "cap_color": "#FCF9EA", "mod_color": "#A8BBA3", "accent_color": "#DB9558" } },
        { "type": "quote", "settings": { "quote": "Switches came perfectly lubed. The thock is unreal for the price, my flatmate hates it.", "author": "Daniel R.", "build": "75% · oat linear · terracotta", "wpm": "118", "layout": "75", "case_color": "#EDE5CC", "cap_color": "#FFF6E8", "mod_color": "#DB9558", "accent_color": "#97A87A" } },
        { "type": "quote", "settings": { "quote": "Calm packaging, a handwritten note, zero plastic junk. My desk finally feels finished.", "author": "Sasha T.", "build": "TKL · lake clicky · olive grove", "wpm": "76", "layout": "tkl", "case_color": "#6F7F5A", "cap_color": "#E4EAD9", "mod_color": "#97A87A", "accent_color": "#DB9558" } }
      ]
    }
  ]
}
{% endschema %}
