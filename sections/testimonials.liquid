<div class="testimonials section">
  <div class="section-head">
    <div class="section-head__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="testimonials__grid">
    {%- for block in section.blocks -%}
      <figure class="quote" {{ block.shopify_attributes }}>
        <div class="quote__stars" aria-label="{{ 'testimonials.rating' | t: rating: block.settings.rating }}">
          {%- for i in (1..5) -%}
            <span{% if i > block.settings.rating %} class="is-off"{% endif %}></span>
          {%- endfor -%}
        </div>
        <blockquote>{{ block.settings.quote }}</blockquote>
        <figcaption>
          <span class="quote__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 }}</span>
          <span>
            <strong>{{ block.settings.author }}</strong>
            {%- if block.settings.build != blank -%}<small>{{ block.settings.build }}</small>{%- endif -%}
          </span>
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: clamp(0.9rem, 0.6rem + 1vw, 1.5rem);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .quote:nth-child(3n + 2) {
    background: var(--color-secondary-soft);
    box-shadow: none;
  }

  .quote blockquote {
    flex: 1;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .quote__stars {
    display: flex;
    gap: 0.25rem;
  }

  .quote__stars span {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 3px;
    background: var(--color-accent);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.14);
  }

  .quote__stars .is-off {
    background: var(--color-border);
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quote figcaption small {
    display: block;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .quote__avatar {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.8rem;
    background: var(--color-tertiary);
    font-weight: 700;
    box-shadow: var(--shadow-key);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.testimonials",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "From the typing room" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "People type happier here" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:general.quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "t:labels.text", "default": "The builder made it so easy to see what I was getting." },
        { "type": "text", "id": "author", "label": "t:labels.author", "default": "Customer" },
        { "type": "text", "id": "build", "label": "t:labels.caption" },
        { "type": "range", "id": "rating", "label": "t:labels.rating", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.testimonials",
      "blocks": [
        { "type": "quote", "settings": { "quote": "I'd never built a keyboard before. Seeing the colours on the preview sold me — and it arrived exactly like that.", "author": "Mira K.", "build": "65% · Tactile · Sage caps", "rating": 5 } },
        { "type": "quote", "settings": { "quote": "Switches came perfectly lubed. The thock is unreal for the price.", "author": "Daniel R.", "build": "75% · Linear · Cream caps", "rating": 5 } },
        { "type": "quote", "settings": { "quote": "Helpful people, calm packaging, zero plastic junk. My desk finally feels finished.", "author": "Sasha T.", "build": "TKL · Clicky", "rating": 4 } }
      ]
    }
  ]
}
{% endschema %}
