<div class="builder-promo section">
  <div class="builder-promo__card">
    <div class="builder-promo__media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
      {%- else -%}
        <img src="{{ 'illo-builder.svg' | asset_url }}" alt="" width="900" height="640" loading="lazy">
      {%- endif -%}
    </div>

    <div class="builder-promo__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="builder-promo__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <ol class="steps">
        {%- for block in section.blocks -%}
          <li class="step" {{ block.shopify_attributes }}>
            <span class="step__key" aria-hidden="true">{{ forloop.index }}</span>
            <div>
              <h3 class="h4">{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>

      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--lg" href="{{ section.settings.button_link | default: '/pages/build' }}">
          {{ section.settings.button_label }}
          {{ 'icon-arrow.svg' | inline_asset_content }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .builder-promo__card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    padding: clamp(1.25rem, 0.5rem + 3vw, 3.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-tertiary);
  }

  .builder-promo__media img {
    width: 100%;
    border-radius: var(--radius);
  }

  .builder-promo__text {
    margin-top: 1rem;
    font-size: 1.05rem;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .step p {
    margin-top: 0.2rem;
    font-size: 0.925rem;
    color: var(--color-muted);
  }

  .step__key {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.8rem;
    background: var(--color-background);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.1rem;
    box-shadow: inset 0 -4px 0 var(--color-border), 0 0 0 1px var(--color-border);
  }

  .step:first-child .step__key {
    background: var(--color-accent);
    box-shadow: var(--shadow-key);
  }

  @media (max-width: 989px) {
    .builder-promo__card {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.builder_promo",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Build Your Keyboard" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Three parts. One board that's only yours." },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Our builder shows your keyboard come together as you choose. We handle the soldering, lubing and testing.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Start building" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "settings": [
        { "type": "text", "id": "title", "label": "t:labels.heading", "default": "Pick a base" },
        { "type": "textarea", "id": "text", "label": "t:labels.text", "default": "60%, 65%, 75% or TKL — in a case colour you like." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.builder_promo",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick a base", "text": "60%, 65%, 75% or TKL — in a case colour you like." } },
        { "type": "step", "settings": { "title": "Choose your switches", "text": "Smooth linears, bumpy tactiles or crisp clickies." } },
        { "type": "step", "settings": { "title": "Dress it in keycaps", "text": "See the colours on your board before you buy." } }
      ]
    }
  ]
}
{% endschema %}
