{%- liquid
  assign receipt_lines = section.settings.receipt_lines | newline_to_br | split: '<br />'
-%}

<div class="builder-promo section">
  <div class="builder-promo__card">
    <div class="builder-promo__media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
      {%- else -%}
        <img src="{{ 'illo-builder.svg' | asset_url }}" alt="" width="900" height="640" loading="lazy">
      {%- endif -%}

      {%- if section.settings.receipt_title != blank -%}
        <figure class="receipt" aria-label="{{ section.settings.receipt_title | escape }}">
          <p class="receipt__head">
            <span>{{ section.settings.receipt_title }}</span>
            <span>{{ section.settings.receipt_id }}</span>
          </p>
          <dl class="receipt__lines">
            {%- for line in receipt_lines -%}
              {%- assign pair = line | strip | split: ':' -%}
              {%- if pair.size > 1 -%}
                <div>
                  <dt>{{ pair[0] | strip }}</dt>
                  <dd>{{ pair[1] | strip }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
          <p class="receipt__total">
            <span>{{ 'home.receipt_total' | t }}</span>
            <span>{{ section.settings.receipt_total }}</span>
          </p>
          <span class="receipt__barcode" aria-hidden="true"></span>
          <p class="receipt__foot">{{ section.settings.receipt_foot }}</p>
        </figure>
      {%- endif -%}
    </div>

    <div class="builder-promo__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="builder-promo__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <ol class="steps">
        {%- for block in section.blocks -%}
          <li class="step" {{ block.shopify_attributes }}>
            <span class="step__key" aria-hidden="true">{{ forloop.index }}</span>
            <div>
              <h3 class="h4">{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>

      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--lg" href="{{ section.settings.button_link | default: '/pages/build' }}">
          {{ section.settings.button_label }}
          {{ 'icon-arrow.svg' | inline_asset_content }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .builder-promo__card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    padding: clamp(1.25rem, 0.5rem + 3vw, 3.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-tertiary);
    color: var(--color-on-secondary);
  }

  .builder-promo__media {
    position: relative;
    padding-bottom: 4rem;
  }

  .builder-promo__media > img {
    width: 100%;
    border-radius: var(--radius);
  }

  /* A paper receipt with a torn, zig-zag bottom edge. */
  .receipt {
    position: absolute;
    right: -0.5rem;
    bottom: 0;
    width: min(17rem, 70%);
    margin: 0;
    padding: 1.1rem 1.1rem 1.4rem;
    background: #fffef8;
    color: #2f2b22;
    font-family: var(--font-label);
    font-size: 0.72rem;
    line-height: 1.5;
    transform: rotate(2.5deg);
    filter: drop-shadow(0 10px 14px rgb(47 43 34 / 0.18));
    --zig: 8px;
    mask:
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / calc(var(--zig) * 2) var(--zig) repeat-x,
      linear-gradient(#000 0 0) top / 100% calc(100% - var(--zig) + 1px) no-repeat;
    transition: transform 0.3s ease;
  }

  .builder-promo__card:hover .receipt {
    transform: rotate(1deg) translateY(-4px);
  }

  .receipt__head,
  .receipt__total {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .receipt__head {
    padding-bottom: 0.6rem;
    font-weight: 700;
  }

  .receipt__lines {
    margin: 0;
    padding-block: 0.5rem;
    background:
      repeating-linear-gradient(90deg, currentColor 0 4px, transparent 4px 8px) top / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, currentColor 0 4px, transparent 4px 8px) bottom / 100% 1px no-repeat;
  }

  .receipt__lines > div {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  /* Dotted leader between label and value. */
  .receipt__lines dt {
    display: flex;
    flex: 1;
    gap: 0.4rem;
    opacity: 0.65;
    white-space: nowrap;
  }

  .receipt__lines dt::after {
    content: '';
    flex: 1;
    height: 2px;
    align-self: flex-end;
    margin-bottom: 0.35em;
    background: radial-gradient(circle, currentColor 0.7px, transparent 1px) left / 4px 2px repeat-x;
  }

  .receipt__lines dd {
    margin: 0;
    text-align: right;
  }

  .receipt__total {
    padding-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .receipt__barcode {
    display: block;
    height: 2rem;
    margin-top: 0.8rem;
    background: repeating-linear-gradient(
      90deg,
      currentColor 0 2px,
      transparent 2px 4px,
      currentColor 4px 5px,
      transparent 5px 8px,
      currentColor 8px 11px,
      transparent 11px 12px,
      currentColor 12px 13px,
      transparent 13px 16px
    );
  }

  .receipt__foot {
    margin-top: 0.5rem;
    text-align: center;
    opacity: 0.6;
  }

  .builder-promo__text {
    margin-top: 1rem;
    font-size: 1.05rem;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.14);
    transition: background-color 0.2s ease;
  }

  .step:hover {
    background: rgb(255 255 255 / 0.24);
  }

  .step p {
    margin-top: 0.2rem;
    font-size: 0.925rem;
    opacity: 0.85;
  }

  .step__key {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.8rem;
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1rem;
    box-shadow: inset 0 -4px 0 var(--color-well-strong);
  }

  .step:first-child .step__key {
    background: var(--color-accent);
    box-shadow: var(--shadow-key);
  }

  @media (max-width: 989px) {
    .builder-promo__card {
      grid-template-columns: 1fr;
    }

    .receipt {
      right: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .builder-promo__media {
      padding-bottom: 0;
    }

    .receipt {
      position: relative;
      right: auto;
      width: 100%;
      margin-top: -1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.builder_promo",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Build Your Keyboard" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Three parts. One board that's only yours." },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Our builder shows your keyboard come together as you choose. We handle the soldering, lubing and testing.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Start building" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "header", "content": "t:labels.receipt" },
    { "type": "text", "id": "receipt_title", "label": "t:labels.heading", "default": "Build of the week" },
    { "type": "text", "id": "receipt_id", "label": "t:labels.receipt_id", "default": "#AX-0417" },
    {
      "type": "textarea",
      "id": "receipt_lines",
      "label": "t:labels.receipt_lines",
      "info": "t:info.receipt_lines",
      "default": "Base: Axion 65 · Sage\nSwitch: Walnut Tactile 62g\nKeycaps: Meadow PBT\nLube: Krytox 205g0\nSound: deep thock"
    },
    { "type": "text", "id": "receipt_total", "label": "t:labels.receipt_total", "default": "$257.00" },
    { "type": "text", "id": "receipt_foot", "label": "t:labels.caption", "default": "assembled by hand · thank you" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "settings": [
        { "type": "text", "id": "title", "label": "t:labels.heading", "default": "Pick a base" },
        { "type": "textarea", "id": "text", "label": "t:labels.text", "default": "60%, 65%, 75% or TKL — in a case colour you like." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.builder_promo",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick a base", "text": "60%, 65%, 75% or TKL — in a case colour you like." } },
        { "type": "step", "settings": { "title": "Choose your switches", "text": "Smooth linears, bumpy tactiles or crisp clickies." } },
        { "type": "step", "settings": { "title": "Dress it in keycaps", "text": "See the colours on your board before you buy." } }
      ]
    }
  ]
}
{% endschema %}
