{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<div class="featured section">
  {%- if section.settings.sticker != blank -%}
    {%- assign sticker = section.settings.sticker -%}
  {%- endif -%}
  <div class="section-head">
    <div class="section-head__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | default: collection.title }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if collection -%}
      <a class="link-arrow" href="{{ collection.url }}">
        {{ 'collections.view_all' | t }}
        {{ 'icon-arrow.svg' | inline_asset_content }}
      </a>
    {%- endif -%}
  </div>

  <div class="grid grid--products featured__grid" style="--cols: {{ section.settings.columns }};">
    {%- if sticker -%}
      <span class="featured__sticker mono" aria-hidden="true">{{ sticker }}</span>
    {%- endif -%}
    {%- if collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        {% render 'product-card', product: product, index: forloop.index0 %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        {% render 'product-card', index: forloop.index0 %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .featured__grid {
    position: relative;
  }

  .featured__grid .product-card:nth-of-type(4n + 2) .product-card__media {
    background: var(--color-tertiary-soft);
  }

  .featured__grid .product-card:nth-of-type(4n + 3) .product-card__media {
    background: var(--color-accent-soft);
  }

  .featured__grid .product-card:nth-of-type(4n + 4) .product-card__media {
    background: var(--color-secondary-soft);
  }

  /* Round "staff pick" sticker slapped on the first card. */
  .featured__sticker {
    position: absolute;
    z-index: 2;
    top: -0.9rem;
    left: -0.6rem;
    display: grid;
    place-items: center;
    width: 4.6rem;
    height: 4.6rem;
    padding: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    box-shadow: var(--shadow-sm);
    transform: rotate(-14deg);
    pointer-events: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Fresh from the workshop" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Staff favourites" },
    { "type": "text", "id": "text", "label": "t:labels.text" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    { "type": "text", "id": "sticker", "label": "t:labels.sticker", "default": "our pick this month" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns",
      "default": 4
    }
  ],
  "presets": [{ "name": "t:general.featured_collection" }]
}
{% endschema %}
