{%- comment -%}
  Force curves are drawn in a 200×90 box: x = travel 0–4 mm (10 → 190),
  y = force 0–90 gf (80 → 10). Shapes follow typical datasheet curves.
{%- endcomment -%}

<div class="switch-guide section">
  <div class="section-head">
    <div class="section-head__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <p class="switch-guide__hint mono">{{ 'switches.listen_hint' | t }}</p>
  </div>

  <div class="switch-guide__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign kind = block.settings.kind
        case kind
          when 'tactile'
            assign curve = 'M10 57 C20 40 28 27 37 27 S55 47 68 47 L172 33 L190 10'
            assign bump_x = 37
            assign bump_y = 27
          when 'clicky'
            assign curve = 'M10 57 C20 40 28 22 36 22 L42 50 L68 46 L172 33 L190 10'
            assign bump_x = 36
            assign bump_y = 22
          else
            assign curve = 'M10 57 L172 32 L190 10'
            assign bump_x = 0
        endcase
      -%}
      <article class="switch-type switch-type--{{ kind }}" data-switch-card {{ block.shopify_attributes }}>
        <div class="switch-type__media">
          <img src="{{ 'illo-switch-' | append: kind | append: '.svg' | asset_url }}" alt="" width="200" height="220" loading="lazy">
          <button class="switch-type__listen" type="button" data-play-switch="{{ kind }}">
            {{ 'icon-play.svg' | inline_asset_content }}
            <span>{{ 'switches.listen' | t }}</span>
          </button>
        </div>

        <div class="switch-type__body">
          <span class="pill pill--switch pill--{{ kind }}">{{ block.settings.label }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>

          <figure class="curve">
            <svg viewBox="0 0 200 90" role="img" aria-label="{{ 'switches.curve_label' | t: kind: block.settings.label }}">
              <path d="M10 80 H190" class="curve__axis"/>
              <path d="M100 10 V80" class="curve__act"/>
              <path d="{{ curve }} L190 80 L10 80 Z" class="curve__fill"/>
              <path d="{{ curve }}" class="curve__line"/>
              {%- if bump_x > 0 -%}
                <circle cx="{{ bump_x }}" cy="{{ bump_y }}" r="3" class="curve__dot"/>
                <text x="{{ bump_x | plus: 6 }}" y="{{ bump_y | minus: 5 }}" class="curve__label">
                  {%- if kind == 'clicky' %}click{% else %}bump{% endif -%}
                </text>
              {%- endif -%}
              <text x="103" y="17" class="curve__label">act.</text>
              <text x="10" y="89" class="curve__label">0</text>
              <text x="178" y="89" class="curve__label">4mm</text>
            </svg>
          </figure>

          <dl class="specs mono">
            <div><dt>{{ 'switches.actuation' | t }}</dt><dd>{{ block.settings.force }}</dd></div>
            <div><dt>{{ 'switches.travel' | t }}</dt><dd>{{ block.settings.travel }}</dd></div>
            <div><dt>{{ 'switches.sound' | t }}</dt><dd>{{ block.settings.sound_word }}</dd></div>
          </dl>

          {%- if block.settings.collection -%}
            <a class="link-arrow" href="{{ block.settings.collection.url }}">
              {{ 'switches.shop' | t: kind: block.settings.label }}
              {{ 'icon-arrow.svg' | inline_asset_content }}
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .switch-guide__hint {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .switch-guide__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: clamp(0.9rem, 0.6rem + 1vw, 1.5rem);
  }

  .switch-type {
    --tone: var(--color-accent);
    --tone-soft: var(--color-accent-soft);
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .switch-type--tactile {
    --tone: #8c6b4f;
    --tone-soft: var(--color-tertiary-soft);
  }

  .switch-type--clicky {
    --tone: #6f8f9a;
    --tone-soft: var(--color-secondary-soft);
  }

  .switch-type__media {
    position: relative;
    display: grid;
    place-items: center;
    padding: 1.75rem 1rem 0.75rem;
    background: var(--tone-soft);
  }

  .switch-type__media img {
    width: 8.5rem;
    transition: transform 0.12s ease;
  }

  .switch-type.is-playing .switch-type__media img {
    transform: translateY(5px) scaleY(0.97);
  }

  .switch-type__listen {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: var(--shadow-key), var(--shadow-sm);
    transition: transform 0.08s ease;
  }

  .switch-type__listen:active {
    transform: translateY(2px);
  }

  .switch-type__listen svg {
    width: 0.9rem;
    color: var(--tone);
  }

  .switch-type__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem;
    flex: 1;
  }

  .switch-type__body > p {
    min-height: 3.2em;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .curve {
    width: 100%;
    margin: 0.25rem 0 0;
    padding: 0.6rem 0.6rem 0.3rem;
    border-radius: var(--radius-sm);
    background: var(--color-background);
  }

  .curve svg {
    width: 100%;
    overflow: visible;
  }

  .curve__axis {
    stroke: var(--color-well-strong);
    stroke-width: 1;
  }

  .curve__act {
    stroke: var(--color-muted);
    stroke-width: 0.8;
    stroke-dasharray: 2 3;
    opacity: 0.6;
  }

  .curve__fill {
    fill: var(--tone);
    opacity: 0.12;
  }

  .curve__line {
    fill: none;
    stroke: var(--tone);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 400;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.2s ease;
  }

  .switch-type[data-animate]:not(.is-drawn) .curve__line {
    stroke-dashoffset: 400;
  }

  .curve__dot {
    fill: var(--tone);
  }

  .curve__label {
    font-family: var(--font-mono);
    font-size: 7px;
    fill: var(--color-muted);
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
    width: 100%;
    margin: 0;
    font-size: 0.72rem;
  }

  .specs dt {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .specs dd {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .switch-type__body .link-arrow {
    margin-top: auto;
    padding-top: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.switch_guide",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Switch guide" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Not sure which switch? Listen first." },
    { "type": "text", "id": "text", "label": "t:labels.text", "default": "The switch decides how every keystroke feels and sounds. The curve shows how hard the key pushes back as you press it." }
  ],
  "blocks": [
    {
      "type": "switch",
      "name": "t:general.switch_type",
      "settings": [
        {
          "type": "select",
          "id": "kind",
          "label": "t:labels.type",
          "options": [
            { "value": "linear", "label": "Linear" },
            { "value": "tactile", "label": "Tactile" },
            { "value": "clicky", "label": "Clicky" }
          ],
          "default": "linear"
        },
        { "type": "text", "id": "label", "label": "t:labels.label", "default": "Linear" },
        { "type": "text", "id": "title", "label": "t:labels.heading", "default": "Smooth all the way down" },
        { "type": "textarea", "id": "text", "label": "t:labels.text", "default": "No bump, no click. Great for fast typing and gaming." },
        { "type": "text", "id": "force", "label": "t:labels.force", "default": "45 gf" },
        { "type": "text", "id": "travel", "label": "t:labels.travel", "default": "4.0 mm" },
        { "type": "text", "id": "sound_word", "label": "t:labels.sound", "default": "thock" },
        { "type": "collection", "id": "collection", "label": "t:labels.collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.switch_guide",
      "blocks": [
        {
          "type": "switch",
          "settings": { "kind": "linear", "label": "Linear", "title": "Smooth all the way down", "text": "No bump, no click. Quiet, fast and great for gaming.", "force": "45 gf", "travel": "4.0 mm", "sound_word": "thock" }
        },
        {
          "type": "switch",
          "settings": { "kind": "tactile", "label": "Tactile", "title": "A gentle bump you can feel", "text": "A soft bump tells you the key registered. Loved by writers.", "force": "62 gf", "travel": "4.0 mm", "sound_word": "thud" }
        },
        {
          "type": "switch",
          "settings": { "kind": "clicky", "label": "Clicky", "title": "Crisp, loud and satisfying", "text": "Bump plus an audible click. Old-school typewriter energy.", "force": "55 gf", "travel": "3.8 mm", "sound_word": "click" }
        }
      ]
    }
  ]
}
{% endschema %}
