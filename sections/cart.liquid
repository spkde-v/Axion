{% comment %}
  Cart page. Quantity changes auto-submit the form; line items that belong
  to a keyboard build show the build ID they were added with.
{% endcomment %}

<div class="cart section section--tight">
  <header class="page-header">
    <h1>{{ 'cart.title' | t }}</h1>
  </header>

  {%- if cart.item_count > 0 -%}
    <form class="cart__grid" action="{{ routes.cart_url }}" method="post" id="CartForm" data-autosubmit>
      <ul class="cart__items" role="list">
        {%- for item in cart.items -%}
          <li class="line">
            <a class="line__media media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{ item.image | image_url: width: 300, height: 300, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                <img class="line__illo" src="{{ 'illo-keyboard.svg' | asset_url }}" alt="" width="300" height="200" loading="lazy">
              {%- endif -%}
            </a>

            <div class="line__info">
              <a class="line__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="line__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              {%- for property in item.properties -%}
                {%- assign first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and first_char != '_' -%}
                  <span class="pill pill--build">{{ property.first }}: {{ property.last }}</span>
                {%- endif -%}
              {%- endfor -%}
              <div class="line__price">
                {%- if item.original_line_price > item.final_line_price -%}
                  <s>{{ item.original_line_price | money }}</s>
                {%- endif -%}
                {{ item.final_line_price | money }}
              </div>
            </div>

            <div class="line__actions">
              <div class="quantity">
                <button type="button" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">
                  {{- 'icon-minus.svg' | inline_asset_content -}}
                </button>
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="{{ 'products.quantity' | t }}"
                >
                <button type="button" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </button>
              </div>
              <a class="line__remove" href="{{ item.url_to_remove }}" aria-label="{{ 'cart.remove' | t }}">
                {{ 'icon-trash.svg' | inline_asset_content }}
              </a>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <aside class="cart__summary">
        <div class="summary-box">
          <div class="summary-box__row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money_with_currency }}</strong>
          </div>
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="summary-box__row summary-box__row--discount">
                <span>{{ discount.title }}</span>
                <span>-{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
          <p class="summary-box__note">{{ 'cart.taxes_note' | t }}</p>

          {%- if section.settings.show_note -%}
            <label class="field">
              <span>{{ 'cart.note' | t }}</span>
              <textarea class="textarea" name="note" rows="3">{{ cart.note }}</textarea>
            </label>
          {%- endif -%}

          <button class="btn btn--lg btn--block" type="submit" name="checkout">
            {{ 'cart.checkout' | t }}
            {{ 'icon-arrow.svg' | inline_asset_content }}
          </button>
          <noscript>
            <button class="btn btn--ghost btn--block" type="submit">{{ 'cart.update' | t }}</button>
          </noscript>

          {%- if additional_checkout_buttons -%}
            <div class="summary-box__extra">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </aside>
    </form>
  {%- else -%}
    <div class="empty-state">
      <img src="{{ 'illo-keyboard.svg' | asset_url }}" alt="" width="300" height="200" loading="lazy">
      <h2 class="h3">{{ 'cart.empty' | t }}</h2>
      <p>{{ 'cart.empty_text' | t }}</p>
      <div class="empty-state__actions">
        <a class="btn" href="/pages/build">{{ 'cart.start_build' | t }}</a>
        <a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    align-items: start;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  .cart__items {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .line {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 0.75rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .line__media {
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
  }

  .line__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .line__media .line__illo {
    object-fit: contain;
    padding: 12%;
  }

  .line__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    min-width: 0;
  }

  .line__title {
    font-weight: 600;
    text-decoration: none;
  }

  .line__variant {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .line__price {
    font-weight: 600;
  }

  .line__price s {
    margin-right: 0.35rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .pill--build {
    background: var(--color-accent-soft);
    font-size: 0.75rem;
  }

  .line__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .line__remove {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
  }

  .line__remove:hover {
    background: var(--color-accent-soft);
    color: var(--color-foreground);
  }

  .line__remove svg {
    width: 1.25rem;
  }

  .cart__summary {
    position: sticky;
    top: 6.5rem;
  }

  .summary-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border), var(--shadow);
  }

  .summary-box__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .summary-box__row strong {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.5rem;
  }

  .summary-box__row--discount {
    color: var(--color-secondary-dark);
    font-weight: 600;
  }

  .summary-box__note {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .cart__grid {
      grid-template-columns: 1fr;
    }

    .cart__summary {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .line {
      grid-template-columns: 5rem 1fr;
    }

    .line__actions {
      grid-column: 1 / -1;
      justify-content: space-between;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:labels.show_cart_note",
      "default": true
    }
  ]
}
{% endschema %}
