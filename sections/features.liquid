<div class="features section section--tight">
  <ul class="features__list">
    {%- for block in section.blocks -%}
      <li class="feature" {{ block.shopify_attributes }}>
        <span class="feature__icon" aria-hidden="true">
          {{ 'icon-' | append: block.settings.icon | append: '.svg' | inline_asset_content }}
        </span>
        <div>
          <h3 class="h4">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .features__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .feature {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .feature p {
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .feature__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-secondary-soft);
  }

  .feature__icon svg {
    width: 1.4rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.features",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "t:general.feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "keyboard", "label": "Keyboard" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "t:labels.heading", "default": "Fast shipping" },
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "Builds ship in 3–5 days." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "wrench", "title": "Assembled by hand", "text": "Lubed, tuned and tested before it ships." } },
        { "type": "feature", "settings": { "icon": "truck", "title": "Ships in 3–5 days", "text": "Free on builds over $150." } },
        { "type": "feature", "settings": { "icon": "shield", "title": "2-year warranty", "text": "On every keyboard we assemble." } },
        { "type": "feature", "settings": { "icon": "heart", "title": "30-day returns", "text": "Didn't click with you? Send it back." } }
      ]
    }
  ]
}
{% endschema %}
