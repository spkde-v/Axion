<div class="search section section--tight">
  <header class="page-header">
    <h1>{{ 'search.title' | t }}</h1>
    <form class="search__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput">{{ 'search.placeholder' | t }}</label>
      <span class="search__icon" aria-hidden="true">{{ 'icon-search.svg' | inline_asset_content }}</span>
      <input
        class="input"
        id="SearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button class="btn" type="submit">{{ 'search.submit' | t }}</button>
    </form>
    {%- if search.performed -%}
      <p>
        {%- if search.results_count == 0 -%}
          {{ 'search.no_results_html' | t: terms: search.terms }}
        {%- else -%}
          {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
        {%- endif -%}
      </p>
    {%- endif -%}
  </header>

  {%- if search.performed and search.results_count > 0 -%}
    {%- paginate search.results by 24 -%}
      <div class="grid grid--products">
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
            {% render 'product-card', product: result, index: forloop.index0 %}
          {%- else -%}
            <a class="search-result card" href="{{ result.url }}">
              <span class="pill">{{ result.object_type | capitalize }}</span>
              <h2 class="h4">{{ result.title }}</h2>
              <p>{{ result.content | strip_html | truncatewords: 18 }}</p>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .search__form {
    position: relative;
    display: flex;
    gap: 0.5rem;
    max-width: 40rem;
    margin-top: 1.5rem;
  }

  .search__form .input {
    padding-left: 3rem;
    border-radius: var(--radius-sm);
  }

  .search__icon {
    position: absolute;
    top: 50%;
    left: 1rem;
    width: 1.3rem;
    transform: translateY(-50%);
    color: var(--color-muted);
  }

  .search-result {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 1.25rem;
    text-decoration: none;
  }

  .search-result p {
    font-size: 0.9rem;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
