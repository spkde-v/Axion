{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.min_value.value != blank or filter.max_value.value != blank
      assign active_count = active_count | plus: 1
    endif
  endfor
-%}

<div class="collection section section--tight">
  <header class="page-header collection__header">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <span>{{ collection.title }}</span>
    </nav>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.per_page -%}
    <form class="toolbar" data-autosubmit>
      <div class="toolbar__filters">
        {%- if section.settings.enable_filters -%}
          {%- for filter in collection.filters -%}
            <details class="filter" data-dismissable>
              <summary class="pill pill--outline filter__toggle">
                {{ filter.label }}
                {%- if filter.active_values.size > 0 -%}
                  <span class="filter__count">{{ filter.active_values.size }}</span>
                {%- endif -%}
                {{ 'icon-chevron.svg' | inline_asset_content }}
              </summary>
              <div class="filter__panel">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    <ul>
                      {%- for value in filter.values -%}
                        <li>
                          <label class="check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}
                                checked
                              {% endif %}
                              {% if value.count == 0 and value.active == false %}
                                disabled
                              {% endif %}
                            >
                            <span class="check__box" aria-hidden="true">{{ 'icon-check.svg' | inline_asset_content }}</span>
                            <span>{{ value.label }}</span>
                            <small>{{ value.count }}</small>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- when 'price_range' -%}
                    <div class="filter__price">
                      <label class="field">
                        <span>{{ 'collections.from' | t }}</span>
                        <input
                          class="input"
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                          placeholder="0"
                          min="0"
                        >
                      </label>
                      <label class="field">
                        <span>{{ 'collections.to' | t }}</span>
                        <input
                          class="input"
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                          placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}"
                          min="0"
                        >
                      </label>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}

          {%- if active_count > 0 -%}
            <a class="toolbar__clear" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ 'collections.clear' | t }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="toolbar__sort">
        <span class="toolbar__count">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
        <label class="visually-hidden" for="SortBy">{{ 'collections.sort_by' | t }}</label>
        <select class="select" id="SortBy" name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
      <noscript><button class="btn btn--secondary" type="submit">{{ 'collections.apply' | t }}</button></noscript>
    </form>

    {%- if collection.products.size > 0 -%}
      <div class="grid grid--products" style="--cols: {{ section.settings.columns }};">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      </div>
      {%- render 'pagination', paginate: paginate -%}
    {%- else -%}
      <div class="empty-state">
        <img src="{{ 'illo-keycaps.svg' | asset_url }}" alt="" width="200" height="150" loading="lazy">
        <h2 class="h3">{{ 'collections.empty' | t }}</h2>
        {%- if active_count > 0 -%}
          <a class="btn" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .toolbar__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .toolbar__sort {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .toolbar__sort .select {
    width: auto;
    min-height: 2.6rem;
    border-radius: var(--radius-pill);
  }

  .toolbar__count {
    font-size: 0.875rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .toolbar__clear {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .filter {
    position: relative;
  }

  .filter__toggle {
    min-height: 2.6rem;
    padding-inline: 1rem;
    font-size: 0.9rem;
    cursor: pointer;
    list-style: none;
    background: var(--color-surface);
  }

  .filter__toggle::-webkit-details-marker {
    display: none;
  }

  .filter__toggle svg {
    width: 0.95rem;
  }

  .filter[open] .filter__toggle {
    background: var(--color-well-strong);
  }

  .filter__count {
    display: grid;
    place-items: center;
    min-width: 1.3rem;
    height: 1.3rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    font-size: 0.7rem;
  }

  .filter__panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.5rem);
    left: 0;
    width: max-content;
    min-width: 15rem;
    max-width: 20rem;
    max-height: 22rem;
    overflow-y: auto;
    padding: 0.5rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow);
  }

  .filter__panel ul {
    padding: 0;
    list-style: none;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.925rem;
  }

  .check:hover {
    background: var(--color-tertiary-soft);
  }

  .check input {
    position: absolute;
    opacity: 0;
  }

  .check small {
    margin-left: auto;
    color: var(--color-muted);
  }

  .check.is-disabled {
    opacity: 0.45;
    cursor: default;
  }

  .check__box {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 0.4rem;
    background: var(--color-well-strong);
  }

  .check__box svg {
    width: 0.9rem;
    opacity: 0;
  }

  .check input:checked + .check__box {
    background: var(--color-secondary);
    box-shadow: none;
  }

  .check input:checked + .check__box svg {
    opacity: 1;
  }

  .check input:focus-visible + .check__box {
    outline: 2px solid var(--color-accent-dark);
    outline-offset: 2px;
  }

  .filter__price {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.5rem;
  }

  .filter__price .field span {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "t:labels.products_per_page",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "t:labels.enable_filters",
      "default": true
    }
  ]
}
{% endschema %}
