<div class="hero section section--tight">
  <div class="hero__card">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--lg" href="{{ section.settings.button_link | default: '/pages/build' }}">
            {{ section.settings.button_label }}
            {{ 'icon-arrow.svg' | inline_asset_content }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="btn btn--lg btn--ghost" href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label_2 }}
          </a>
        {%- endif -%}
      </div>

      <ul class="hero__stats">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <strong>{{ block.settings.value }}</strong>
            <span>{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="hero__media">
      {%- if section.settings.image -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            fetchpriority: 'high',
            class: 'hero__image'
        }}
      {%- else -%}
        <img
          class="hero__illo"
          src="{{ 'illo-hero.svg' | asset_url }}"
          alt="{{ 'home.hero_illustration_alt' | t }}"
          width="1000"
          height="800"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero__card {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: 2rem;
    padding: clamp(1.75rem, 1rem + 3vw, 4rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border);
    overflow: hidden;
  }

  .hero__title {
    max-width: 14ch;
  }

  .hero__text {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .hero__stats:empty {
    display: none;
  }

  .hero__stats li {
    display: flex;
    flex-direction: column;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius);
    background: var(--color-background);
    box-shadow: inset 0 0 0 1px var(--color-border);
    line-height: 1.3;
  }

  .hero__stats strong {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.3rem;
  }

  .hero__stats span {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .hero__media {
    position: relative;
  }

  .hero__image {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .hero__illo {
    width: 100%;
    animation: hero-float 7s ease-in-out infinite;
  }

  @keyframes hero-float {
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 989px) {
    .hero__card {
      grid-template-columns: 1fr;
    }

    .hero__media {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Mechanical keyboard workshop" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Keyboards that feel like yours" },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Pick a case, choose the switches you love and dress it in keycaps. We assemble, lube and test every build by hand.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Build your keyboard" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "text", "id": "button_label_2", "label": "t:labels.button_label_secondary", "default": "Shop all" },
    { "type": "url", "id": "button_link_2", "label": "t:labels.button_link_secondary" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:general.stat",
      "settings": [
        { "type": "text", "id": "value", "label": "t:labels.value", "default": "40+" },
        { "type": "text", "id": "label", "label": "t:labels.label", "default": "switches tested" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "40+", "label": "switches tested" } },
        { "type": "stat", "settings": { "value": "3 steps", "label": "to your own board" } },
        { "type": "stat", "settings": { "value": "2 yr", "label": "build warranty" } }
      ]
    }
  ]
}
{% endschema %}
