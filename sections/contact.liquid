{%- liquid
  assign s = section.settings
  assign maps_query = s.address | strip_html | strip_newlines | url_encode
  assign topics = s.topics | split: ','
  assign contact_blocks = section.blocks | where: 'type', 'contact'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
-%}

<div class="contact section section--tight" data-contact>
  <header class="contact__head">
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h1>{{ s.heading }}</h1>
    {%- if s.text != blank -%}<div class="contact__intro">{{ s.text }}</div>{%- endif -%}
    {%- if s.reply_time != blank -%}
      <p class="contact__reply">
        <span class="contact__reply-dot" aria-hidden="true"></span>
        {{ s.reply_time }}
      </p>
    {%- endif -%}
  </header>

  <div class="contact__grid">
    {%- comment -%} ---------- Form ---------- {%- endcomment -%}
    <div class="contact__form-card">
      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact-form__done" role="status">
            <span class="contact-form__done-key" aria-hidden="true">{{ 'icon-check.svg' | inline_asset_content }}</span>
            <h2 class="h3">{{ 'contact.success_title' | t }}</h2>
            <p>{{ 'contact.success_text' | t }}</p>
            <a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
          </div>
        {%- else -%}
          <h2 class="h3 contact-form__title">{{ s.form_heading }}</h2>

          {%- if form.errors -%}
            <div class="contact-form__errors" role="alert">
              <strong>{{ 'contact.error' | t }}</strong>
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if topics.size > 0 -%}
            <fieldset class="topics">
              <legend>{{ 'contact.topic' | t }}</legend>
              <div class="topics__keys">
                {%- for topic in topics -%}
                  {%- assign topic_value = topic | strip -%}
                  <label class="topic">
                    <input
                      type="radio"
                      name="contact[topic]"
                      value="{{ topic_value | escape }}"
                      {% if forloop.first %}
                        checked
                      {% endif %}
                    >
                    <span>{{ topic_value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          <div class="contact-form__row">
            <label class="field">
              <span>{{ 'contact.name' | t }}</span>
              <input
                class="input"
                type="text"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              >
            </label>
            <label class="field">
              <span>{{ 'contact.email' | t }} <em aria-hidden="true">*</em></span>
              <input
                class="input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
                aria-required="true"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              >
            </label>
          </div>

          <div class="contact-form__row">
            <label class="field">
              <span>{{ 'contact.phone' | t }} <small>{{ 'contact.optional' | t }}</small></span>
              <input class="input" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
            </label>
            <label class="field">
              <span>{{ 'contact.order' | t }} <small>{{ 'contact.optional' | t }}</small></span>
              <input class="input" type="text" name="contact[order]" placeholder="#1042" value="{{ form.order }}">
            </label>
          </div>

          <label class="field">
            <span class="field__label-row">
              <span>{{ 'contact.message' | t }} <em aria-hidden="true">*</em></span>
              <small class="contact-form__count" data-count aria-live="polite">0 / 1000</small>
            </span>
            <textarea
              class="textarea"
              name="contact[body]"
              rows="6"
              maxlength="1000"
              required
              aria-required="true"
              placeholder="{{ s.message_placeholder | escape }}"
              data-count-source
            >{{ form.body }}</textarea>
          </label>

          <div class="contact-form__submit">
            <button class="btn btn--lg" type="submit">
              {{ 'contact.send' | t }}
              <span class="kbd" aria-hidden="true">↵</span>
            </button>
            <p class="contact-form__note">{{ s.privacy_note }}</p>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- comment -%} ---------- Info ---------- {%- endcomment -%}
    <aside class="contact__aside">
      {%- if s.address != blank -%}
        <div class="map-card">
          <a
            class="map"
            href="https://www.google.com/maps/search/?api=1&query={{ maps_query }}"
            target="_blank"
            rel="noopener"
            aria-label="{{ 'contact.open_map' | t }}"
          >
            {%- if s.map_image -%}
              {{ s.map_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30rem, 100vw', class: 'map__image' }}
            {%- else -%}
              <svg class="map__art" viewBox="0 0 400 240" aria-hidden="true" focusable="false">
                <rect width="400" height="240" fill="var(--color-tertiary-soft)"/>
                <path d="M-10 190 C60 170 90 205 160 188 S260 150 300 165 410 150 410 150 V260 H-10Z" fill="var(--color-tertiary)" opacity=".55"/>
                <rect x="36" y="28" width="86" height="58" rx="14" fill="var(--color-secondary)" opacity=".45"/>
                <rect x="262" y="34" width="70" height="44" rx="12" fill="var(--color-surface)" opacity=".7"/>
                <rect x="150" y="104" width="64" height="40" rx="10" fill="var(--color-surface)" opacity=".7"/>
                <rect x="286" y="104" width="84" height="40" rx="10" fill="var(--color-surface)" opacity=".7"/>
                <g fill="none" stroke="var(--color-surface)" stroke-linecap="round">
                  <path d="M-10 96 H410" stroke-width="12"/>
                  <path d="M136 -10 V250" stroke-width="12"/>
                  <path d="M244 -10 C236 60 250 120 234 250" stroke-width="10"/>
                  <path d="M-10 160 C80 150 150 162 240 150" stroke-width="7"/>
                  <path d="M350 -10 V96" stroke-width="7"/>
                </g>
                <g fill="none" stroke="var(--color-accent)" stroke-width="3" stroke-dasharray="1 7" stroke-linecap="round">
                  <path d="M60 222 C92 196 110 170 136 160 S196 140 214 128 238 120 252 122"/>
                </g>
                <g transform="translate(252 124)"><g class="map__pin">
                  <circle r="26" fill="var(--color-accent)" opacity=".18" class="map__pulse"/>
                  <g transform="translate(-19 -44)">
                    <rect y="4" width="38" height="36" rx="9" fill="var(--color-accent-dark)"/>
                    <rect width="38" height="34" rx="9" fill="var(--color-accent)"/>
                    <rect x="6" y="3" width="26" height="22" rx="6" fill="#fff" opacity=".22"/>
                    <path d="M13.5 23 19 9l5.5 14M15.5 18h7" fill="none" stroke="var(--color-foreground)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </g>
                  <path d="M-5 -6 0 2 5 -6Z" fill="var(--color-accent-dark)"/>
                </g></g>
              </svg>
            {%- endif -%}
            <span class="map__open">
              {{ 'contact.open_map' | t }}
              {{ 'icon-arrow.svg' | inline_asset_content }}
            </span>
          </a>
          <div class="map-card__body">
            <span class="contact-icon" aria-hidden="true">{{ 'icon-pin.svg' | inline_asset_content }}</span>
            <div>
              <p class="contact-label">{{ 'contact.visit' | t }}</p>
              <address class="map-card__address">{{ s.address }}</address>
              {%- if s.address_note != blank -%}<p class="map-card__note">{{ s.address_note }}</p>{%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}

      <div
        class="hours-card"
        data-hours
        data-tz="{{ s.timezone | escape }}"
        data-open="{{ s.open_time | escape }}"
        data-close="{{ s.close_time | escape }}"
        data-days="{{ s.open_days | escape }}"
        data-open-label="{{ 'contact.open_now' | t: time: s.close_time | escape }}"
        data-closed-label="{{ 'contact.closed_now' | t | escape }}"
      >
        <span class="contact-icon" aria-hidden="true">{{ 'icon-clock.svg' | inline_asset_content }}</span>
        <div class="hours-card__main">
          <p class="contact-label">{{ 'contact.hours' | t }}</p>
          <p class="hours-card__text">{{ s.hours_text }}</p>
          <p class="hours-card__status" data-hours-status hidden>
            <span class="hours-card__dot" aria-hidden="true"></span>
            <span data-hours-label></span>
          </p>
        </div>
        <p class="hours-card__clock" data-hours-clock hidden>
          <small>{{ 'contact.local_time' | t }}</small>
          <strong data-hours-time></strong>
        </p>
      </div>

      {%- if contact_blocks.size > 0 -%}
        <ul class="channels" role="list">
          {%- for block in contact_blocks -%}
            {%- liquid
              assign kind = block.settings.kind
              assign value = block.settings.value | strip
              case kind
                when 'email'
                  assign href = 'mailto:' | append: value
                  assign icon = 'icon-mail.svg'
                when 'phone'
                  assign digits = value | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
                  assign href = 'tel:' | append: digits
                  assign icon = 'icon-phone.svg'
                when 'chat'
                  assign href = block.settings.link
                  assign icon = 'icon-chat.svg'
                else
                  assign href = block.settings.link
                  assign icon = 'icon-heart.svg'
              endcase
            -%}
            <li class="channel" {{ block.shopify_attributes }}>
              <span class="contact-icon contact-icon--{{ kind }}" aria-hidden="true">{{ icon | inline_asset_content }}</span>
              <div class="channel__text">
                <p class="contact-label">{{ block.settings.label }}</p>
                {%- if href != blank -%}
                  <a class="channel__value" href="{{ href }}"{% if kind == 'chat' or kind == 'link' %} target="_blank" rel="noopener"{% endif %}>{{ value }}</a>
                {%- else -%}
                  <span class="channel__value">{{ value }}</span>
                {%- endif -%}
                {%- if block.settings.note != blank -%}<small>{{ block.settings.note }}</small>{%- endif -%}
              </div>
              {%- if kind == 'email' or kind == 'phone' -%}
                <button
                  class="channel__copy"
                  type="button"
                  data-copy="{{ value | escape }}"
                  data-copied-label="{{ 'contact.copied' | t | escape }}"
                  aria-label="{{ 'contact.copy' | t }} {{ value | escape }}"
                >
                  {{ 'icon-copy.svg' | inline_asset_content }}
                  <span data-copy-label>{{ 'contact.copy' | t }}</span>
                </button>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </aside>
  </div>

  {%- if faq_blocks.size > 0 -%}
    <div class="contact-faq">
      <div class="contact-faq__head">
        <p class="eyebrow eyebrow--olive">{{ 'contact.faq_eyebrow' | t }}</p>
        <h2>{{ s.faq_heading }}</h2>
      </div>
      <div class="contact-faq__list">
        {%- for block in faq_blocks -%}
          <details class="faq" {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.question }}</span>
              <span class="faq__key" aria-hidden="true">{{ 'icon-plus.svg' | inline_asset_content }}</span>
            </summary>
            <div class="faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .contact__head {
    max-width: 44rem;
    padding-block: 1.5rem 2.25rem;
  }

  .contact__intro {
    margin-top: 1rem;
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .contact__reply {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--color-well);
    font-size: 0.875rem;
  }

  .contact__reply-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-secondary);
    box-shadow: 0 0 0 4px var(--color-secondary-soft);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  /* ---------- Form ---------- */
  .contact__form-card {
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .contact-form .field > span {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .contact-form .field em {
    font-style: normal;
    color: var(--color-accent-dark);
  }

  .contact-form .field small {
    margin-left: 0.25rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .field__label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .contact-form__count {
    font-variant-numeric: tabular-nums;
  }

  .contact-form__count.is-near {
    color: var(--color-accent-dark);
  }

  .contact-form .textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .topics {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .topics legend {
    margin-bottom: 0.6rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .topics__keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .topic {
    position: relative;
    cursor: pointer;
  }

  .topic input {
    position: absolute;
    opacity: 0;
  }

  .topic span {
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    padding: 0.4rem 1rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-well);
    font-size: 0.9rem;
    font-weight: 500;
    box-shadow: inset 0 -3px 0 var(--color-well-strong);
    transition: transform 0.08s ease, background-color 0.2s ease, box-shadow 0.08s ease;
  }

  .topic:hover span {
    background: var(--color-well-strong);
  }

  .topic input:checked + span {
    background: var(--color-accent);
    box-shadow: var(--shadow-key);
    transform: translateY(1px);
  }

  .topic input:focus-visible + span {
    outline: 2px solid var(--color-accent-dark);
    outline-offset: 2px;
  }

  .contact-form__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-top: 0.25rem;
  }

  .contact-form__submit .kbd {
    background: rgb(255 255 255 / 0.4);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.12);
  }

  .contact-form__note {
    flex: 1;
    min-width: 12rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .contact-form__errors {
    padding: 1rem 1.2rem;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    font-size: 0.9rem;
  }

  .contact-form__errors ul {
    margin-top: 0.35rem;
    padding-left: 1.1rem;
  }

  .contact-form__done {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1rem 0;
  }

  .contact-form__done p {
    max-width: 30rem;
    color: var(--color-muted);
  }

  .contact-form__done-key {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background: var(--color-secondary);
    color: var(--color-on-secondary);
    box-shadow: inset 0 -5px 0 var(--color-secondary-dark);
    animation: key-press 0.6s ease 0.2s both;
  }

  .contact-form__done-key svg {
    width: 1.6rem;
  }

  @keyframes key-press {
    40% {
      transform: translateY(4px);
      box-shadow: inset 0 -1px 0 var(--color-secondary-dark);
    }
  }

  /* ---------- Aside ---------- */
  .contact__aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-label {
    margin-bottom: 0.15rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.8rem;
    background: var(--color-background);
    box-shadow: inset 0 -3px 0 var(--color-well-strong);
  }

  .contact-icon svg {
    width: 1.3rem;
  }

  .map-card,
  .hours-card,
  .channels {
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .map-card {
    overflow: hidden;
  }

  .map {
    position: relative;
    display: block;
    aspect-ratio: 5 / 3;
    overflow: hidden;
  }

  .map__art,
  .map__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .map:hover .map__art,
  .map:hover .map__image {
    transform: scale(1.04);
  }

  .map__pin {
    animation: pin-bob 2.8s ease-in-out infinite;
  }

  .map__pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: pin-pulse 2.8s ease-out infinite;
  }

  @keyframes pin-bob {
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes pin-pulse {
    from {
      transform: scale(0.4);
      opacity: 0.5;
    }
    to {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  .map__open {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem 0.55rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: var(--shadow-key), var(--shadow-sm);
  }

  .map__open svg {
    width: 0.9rem;
    transition: transform 0.2s ease;
  }

  .map:hover .map__open svg {
    transform: translateX(3px);
  }

  .map-card__body {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 1.4rem 1.4rem;
  }

  .map-card__address {
    font-style: normal;
    font-weight: 600;
    line-height: 1.45;
  }

  .map-card__note {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .hours-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
  }

  .hours-card__main {
    flex: 1;
    min-width: 0;
  }

  .hours-card__text {
    font-weight: 600;
  }

  .hours-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.5rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-well);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .hours-card__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-muted);
  }

  .hours-card.is-open .hours-card__status {
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .hours-card.is-open .hours-card__dot {
    background: #fff;
    animation: status-blink 1.6s ease-in-out infinite;
  }

  @keyframes status-blink {
    50% {
      opacity: 0.35;
    }
  }

  .hours-card__clock {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: none;
    padding: 0.5rem 0.75rem 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--color-foreground);
    color: var(--color-background);
    line-height: 1.1;
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.35);
  }

  .hours-card__clock small {
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .hours-card__clock strong {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.35rem;
    font-variant-numeric: tabular-nums;
  }

  .channels {
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    list-style: none;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0.9rem;
    border-radius: var(--radius);
    transition: background-color 0.2s ease;
  }

  .channel:hover {
    background: var(--color-well);
  }

  .channel__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .channel__value {
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a.channel__value:hover {
    color: var(--color-accent-dark);
  }

  .channel__text small {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .contact-icon--email {
    background: var(--color-accent-soft);
  }

  .contact-icon--phone {
    background: var(--color-secondary-soft);
  }

  .contact-icon--chat {
    background: var(--color-tertiary-soft);
  }

  .channel__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    padding: 0.4rem 0.7rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-background);
    font-size: 0.75rem;
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--color-well-strong);
    transition: transform 0.08s ease, background-color 0.2s ease;
  }

  .channel__copy:active {
    transform: translateY(2px);
  }

  .channel__copy svg {
    width: 0.9rem;
  }

  .channel__copy.is-copied {
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  /* ---------- FAQ ---------- */
  .contact-faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1.5rem clamp(1.5rem, 1rem + 3vw, 4rem);
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .contact-faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .faq {
    border-radius: var(--radius);
    background: var(--color-well);
    transition: background-color 0.2s ease;
  }

  .faq[open] {
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 1rem 1.3rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq__key {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.6rem;
    background: var(--color-surface);
    box-shadow: inset 0 -3px 0 var(--color-well-strong);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .faq__key svg {
    width: 1rem;
    transition: transform 0.25s ease;
  }

  .faq[open] .faq__key {
    background: var(--color-accent);
    box-shadow: var(--shadow-key);
  }

  .faq[open] .faq__key svg {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding: 0 1.3rem 1.25rem;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .contact__grid,
    .contact-faq {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }

    .hours-card {
      flex-wrap: wrap;
    }
  }
{% endstylesheet %}

