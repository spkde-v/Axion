<div class="page section section--tight">
  <header class="page-header">
    <h1>{{ page.title }}</h1>
  </header>
  <div class="page__content rte">
    {{ page.content }}
  </div>
</div>

{% stylesheet %}
  .page__content {
    max-width: 46rem;
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border);
    font-size: 1.05rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
