{%- liquid
  assign illos = 'illo-keyboard.svg,illo-switch-linear.svg,illo-keycaps.svg,illo-switch-tactile.svg' | split: ','
-%}

<div class="collections-list section section--tight">
  <header class="page-header">
    <h1>{{ 'collections.title' | t }}</h1>
  </header>

  <div class="categories__grid">
    {%- for collection in collections -%}
      {%- assign i = forloop.index0 | modulo: 4 -%}
      <a class="category" href="{{ collection.url }}" style="--tile: var(--color-tertiary-soft);">
        <div class="category__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw' }}
          {%- else -%}
            <img class="category__illo" src="{{ illos[i] | asset_url }}" alt="" width="400" height="300" loading="lazy">
          {%- endif -%}
        </div>
        <div class="category__info">
          <div>
            <h2 class="h3">{{ collection.title }}</h2>
            <p>{{ 'collections.product_count' | t: count: collection.products_count }}</p>
          </div>
          <span class="category__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": []
}
{% endschema %}
