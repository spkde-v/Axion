<div class="blog section section--tight">
  <header class="page-header">
    <p class="eyebrow">{{ 'blog.journal' | t }}</p>
    <h1>{{ blog.title }}</h1>
  </header>

  {%- paginate blog.articles by 9 -%}
    <div class="blog__grid">
      {%- for article in blog.articles -%}
        <article class="post-card">
          <a class="post-card__media media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}
            {%- else -%}
              <img class="post-card__illo" src="{{ 'illo-keycaps.svg' | asset_url }}" alt="" width="300" height="220" loading="lazy">
            {%- endif -%}
          </a>
          <div class="post-card__body">
            <p class="post-card__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h2 class="h3"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .blog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: 1.5rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border);
    overflow: hidden;
  }

  .post-card__media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: 0;
  }

  .post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card__media .post-card__illo {
    width: 55%;
    height: auto;
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
  }

  .post-card__body a {
    text-decoration: none;
  }

  .post-card__body > p:last-child {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .post-card__meta {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
