{%- if section.settings.text != blank -%}
  <div class="announcement full-width" style="--bar-bg: {{ section.settings.background }};">
    <p class="announcement__text">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement {
    background: var(--bar-bg, var(--color-secondary));
    padding: 0.55rem var(--page-margin);
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .announcement a {
    text-decoration: none;
  }

  .announcement a:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.announcement_bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Free shipping on builds over $150 · Hand-lubed switches, made to order"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:labels.background",
      "default": "#A8BBA3"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
