[
  {
    "name": "theme_info",
    "theme_name": "Axion",
    "theme_version": "1.0.0",
    "theme_author": "Axion",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 4,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "rubik_n5",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "dm_sans_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          { "value": "80rem", "label": "t:options.page_width.narrow" },
          { "value": "96rem", "label": "t:options.page_width.wide" }
        ],
        "default": "80rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 60,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 36,
        "step": 2,
        "unit": "px",
        "label": "t:labels.corner_radius",
        "default": 22
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FCF9EA",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#FFFDF4",
        "label": "t:labels.surface"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#2F2B22",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#DB9558",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "secondary_color",
        "default": "#97A87A",
        "label": "t:labels.secondary"
      },
      {
        "type": "color",
        "id": "tertiary_color",
        "default": "#A8BBA3",
        "label": "t:labels.tertiary"
      }
    ]
  },
  {
    "name": "t:general.social",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_discord", "label": "Discord" }
    ]
  }
]
